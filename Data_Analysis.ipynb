    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\nTarget variable: {target_col}\\\")\\n\",\n",
    "    \"print(df[target_col].describe())\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Outlier detection\\n\",\n",
    "    \"Q1 = df[target_col].quantile(0.25)\\n\",\n",
    "    \"Q3 = df[target_col].quantile(0.75)\\n\",\n",
    "    \"IQR = Q3 - Q1\\n\",\n",
    "    \"lower_bound = Q1 - 1.5 * IQR\\n\",\n",
    "    \"upper_bound = Q3 + 1.5 * IQR\\n\",\n",
    "    \"\\n\",\n",
    "    \"outliers = df[(df[target_col] < lower_bound) | (df[target_col] > upper_bound)]\\n\",\n",
    "    \"print(f\\\"\\\\nOutliers (IQR method): {len(outliers)} ({len(outliers)/len(df)*100:.2f}%)\\\")\\n\",\n",
    "    \"print(f\\\"Outlier range: {outliers[target_col].min():.2f} to {outliers[target_col].max():.2f}\\\")\\n\",\n",
