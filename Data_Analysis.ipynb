    "   \"source\": [\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n\",\n",
    "    \"print(\\\"RED FLAGS DETECTION\\\")\\n\",\n",
    "    \"print(\\\"=\\\" * 80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"red_flags = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Impossible values\\n\",\n",
    "    \"if (df['delivery_time_hours'] < 0).sum() > 0:\\n\",\n",
    "    \"    red_flags.append(\\\"Negative delivery times detected\\\")\\n\",\n",
    "    \"if (df['distance_km'] < 0).sum() > 0:\\n\",\n",
    "    \"    red_flags.append(\\\"Negative distances detected\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Duplicate order IDs\\n\",\n",
    "    \"duplicate_rate = df['order_id'].duplicated().sum() / len(df) * 100\\n\",\n",
    "    \"if duplicate_rate > 10:\\n\",\n",
    "    \"    red_flags.append(f\\\"High duplicate order ID rate: {duplicate_rate:.1f}%\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Same origin-destination\\n\",\n",
    "    \"same_city = (df['origin_city'] == df['destination_city']).sum()\\n\",\n",
    "    \"if same_city > 0:\\n\",\n",
    "    \"    red_flags.append(f\\\"Same origin-destination orders: {same_city}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Red flags identified:\\\")\\n\",\n",
    "    \"for i, flag in enumerate(red_flags, 1):\\n\",\n",
